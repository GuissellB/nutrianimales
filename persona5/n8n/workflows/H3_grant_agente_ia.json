{
  "name": "P5 H3 – Privilegios de escritura agente_ia",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.4,
      "position": [
        0,
        0
      ],
      "id": "bf888f07-faf0-40e7-b87b-b27ed74d2bba",
      "name": "Cada minuto"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT COUNT(*)::int AS total_permisos,\n COALESCE(string_agg(n.nspname || '.' || c.relname, ', ' ORDER BY c.relname),'Ninguno') AS tablas\nFROM pg_catalog.pg_class c\nJOIN pg_catalog.pg_namespace n ON n.oid = c.relnamespace\nWHERE n.nspname='public' AND c.relkind IN ('r','p')\n  AND (\n    pg_catalog.has_table_privilege('agente_ia',c.oid,'INSERT') OR\n    pg_catalog.has_table_privilege('agente_ia',c.oid,'UPDATE') OR\n    pg_catalog.has_table_privilege('agente_ia',c.oid,'DELETE')\n  );",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        245,
        0
      ],
      "id": "c281105a-a96f-4ff1-9edd-75e8d9818080",
      "name": "Verificar permisos de agente_ia"
    },
    {
      "parameters": {
        "jsCode": "const d = $input.first().json;\nconst mem = $getWorkflowStaticData('global');\nconst total = Number(d.total_permisos || 0);\nconst peligro = total > 0;\nconst alerta = peligro && !mem.h3Activo;\nmem.h3Activo = peligro;\nreturn [{json:{alerta,total,tablas:d.tablas}}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        470,
        0
      ],
      "id": "81ac4ab3-e15a-49d7-aff5-8c7630c418cc",
      "name": "Evaluar H3"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },

    {
      "parameters": {
        "jsCode": "// Filtro defensivo A2: se ejecuta inmediatamente después del Webhook local.\n// Adaptado del filtro A2 que ya existe en persona5/n8n/snippets.\n// No se conecta a PostgreSQL ni ejecuta el contenido recibido como SQL.\nconst entrada = $input.first().json;\nconst body = entrada.body ?? {};\nconst mensaje = body.message ?? {};\nconst texto = String(mensaje.text ?? '').slice(0, 4000);\nconst patrones = [\n  /;\\s*(drop|delete|truncate|alter|create|grant|revoke|insert|update)\\b/i,\n  /\\b(drop|truncate)\\s+(table|database|schema|role|user)\\b/i,\n  /\\bunion\\s+(all\\s+)?select\\b/i,\n  /--\\s*$|\\/\\*|\\*\\//,\n  /\\b(pg_sleep|pg_read_file|copy\\s+.*\\s+program|lo_import|xp_cmdshell)\\b/i,\n  /\\bor\\s+1\\s*=\\s*1\\b/i,\n];\nconst coincidencias = patrones.filter(p => p.test(texto)).map(p => p.source);\nconst bloqueado = coincidencias.length > 0;\nreturn [{ json: {\n  escenario: 'A2',\n  origen: 'Telegram recibido por relay local',\n  texto_recibido: texto,\n  chat_id: mensaje.chat?.id ?? null,\n  bloqueado,\n  decision: bloqueado ? 'BLOQUEADO' : 'PERMITIDO_SIN_CONSULTA',\n  motivo: bloqueado ? 'Patrones SQL peligrosos detectados' : 'Sin patrones bloqueados',\n  reglas: coincidencias,\n  sql_ejecutado: false,\n  fecha_utc: new Date().toISOString(),\n}}];"
      },

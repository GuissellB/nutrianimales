# Cuenta administrativa de bootstrap; los servicios deben usar cuentas RBAC.
POSTGRES_DB=nutrianimales_db
POSTGRES_USER=postgres
# Definir localmente antes de iniciar. No usar este archivo como env_file.
POSTGRES_PASSWORD=
# Opcional: si el servidor ya usa otras bibliotecas, conservarlas en esta lista.
# POSTGRES_SHARED_PRELOAD_LIBRARIES=pg_stat_statements,auto_explain

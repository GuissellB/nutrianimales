    {
      "parameters": {
        "jsCode": "// compara filas acumuladas contra la medicion anterior\nconst memoria = $getWorkflowStaticData('global');\nconst previo = memoria.d6 || null;\nconst umbral = 50;\nconst actual = {};\nconst hallazgos = [];\n\nfor (const item of $input.all()) {\n  const f = item.json;\n  if (!f.queryid) continue; // ignora el item vacio cuando no hay filas\n  const clave = f.queryid + ':' + f.usuario;\n  const filas = Number(f.rows);\n  actual[clave] = filas;\n  if (previo === null) continue; // primera ejecucion: solo guarda la base\n  let antes = previo[clave] || 0;\n  if (filas < antes) antes = 0; // las estadisticas se reiniciaron\n  const delta = filas - antes;\n  if (delta > umbral) {\n    const tabla = (f.query.match(/UPDATE\\s+(?:ONLY\\s+)?([\\w.\"]+)/i) || [])[1] || 'desconocida';\n    hallazgos.push({ tabla, filas: delta, usuario: f.usuario, query: f.query });\n  }\n}\n\nmemoria.d6 = actual;\nconst h = hallazgos[0] || {};\nreturn [{ json: {\n  alerta_d6: hallazgos.length > 0,\n  total: hallazgos.length,\n  tabla: h.tabla || '',\n  filas: h.filas || 0,\n  usuario: h.usuario || '',\n  query: h.query || ''\n} }];"
      },

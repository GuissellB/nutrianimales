    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH cambios AS (\n    SELECT b.name AS parametro, b.valor_esperado, s.setting AS valor_actual\n    FROM public.pg_settings_baseline b\n    JOIN pg_catalog.pg_settings s ON s.name = b.name\n    WHERE b.name IN ('ssl', 'password_encryption')\n      AND s.setting IS DISTINCT FROM b.valor_esperado\n)\nSELECT COUNT(*)::int AS total_cambios,\n       COALESCE(STRING_AGG(parametro || ': ' || valor_esperado || ' -> ' || valor_actual, ' | '), 'Ninguno') AS detalle_cambios,\n       COUNT(*) > 0 AS alerta_h5\nFROM cambios;",
        "options": {}
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,

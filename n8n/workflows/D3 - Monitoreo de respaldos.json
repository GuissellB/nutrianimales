    {
      "parameters": {
        "jsCode": "\nconst memoria = $getWorkflowStaticData('global');\n\nconst resultados = [];\n\nfor (const item of $input.all()) {\n  const dato = item.json;\n\n  if (dato.alerta_d3 !== true) {\n    continue;\n  }\n\n  const ultimoBackup = dato.ultimo_backup ?? 'SIN_BACKUP';\n\n  const identificador = String(ultimoBackup);\n\n  if (memoria.ultimoAvisoD3 === identificador) {\n    continue;\n  }\n\n  memoria.ultimoAvisoD3 = identificador;\n  resultados.push(item);\n}\n\nreturn resultados;\n"
      },

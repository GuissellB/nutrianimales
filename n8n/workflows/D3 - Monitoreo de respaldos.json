    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT\n    MAX(fecha) FILTER (\n        WHERE LOWER(estado) IN ('exitoso', 'completado', 'success')\n    ) AS ultimo_backup,\n    CASE\n        WHEN MAX(fecha) FILTER (\n            WHERE LOWER(estado) IN ('exitoso', 'completado', 'success')\n        ) IS NULL THEN true\n        WHEN MAX(fecha) FILTER (\n            WHERE LOWER(estado) IN ('exitoso', 'completado', 'success')\n        ) < NOW() - INTERVAL '24 hours' THEN true\n        ELSE false\n    END AS alerta_d3\nFROM backups;",
        "options": {}

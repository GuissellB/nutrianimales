    {
      "parameters": {
        "jsCode": "// suma las filas leidas en tablas sensibles desde la medicion anterior\nconst memoria = $getWorkflowStaticData('global');\nconst previo = memoria.d7 || null;\nconst umbral = 1000;\nconst actual = {};\nlet total = 0;\nconst detalle = [];\nconst usuarios = new Set();\n\nfor (const item of $input.all()) {\n  const f = item.json;\n  if (!f.queryid) continue; // ignora el item vacio cuando no hay filas\n  const clave = f.queryid + ':' + f.usuario;\n  const filas = Number(f.rows);\n  actual[clave] = filas;\n  if (previo === null) continue; // primera ejecucion: solo guarda la base\n  let antes = previo[clave] || 0;\n  if (filas < antes) antes = 0; // las estadisticas se reiniciaron\n  const delta = filas - antes;\n  if (delta > 0) {\n    total += delta;\n    usuarios.add(f.usuario);\n    detalle.push(f.query + ' (' + delta + ' filas)');\n  }\n}\n\nmemoria.d7 = actual;\nreturn [{ json: {\n  alerta_d7: total > umbral,\n  filas_total: total,\n  usuarios: Array.from(usuarios).join(', '),\n  consultas: detalle.join(' | ')\n} }];"
      },

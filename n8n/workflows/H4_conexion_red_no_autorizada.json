        "jsCode": "// evita repetir la misma alerta mientras la conexion siga abierta\nconst memoria = $getWorkflowStaticData('global');\nconst actual = $input.first().json;\nconst firma = actual.alerta_h4 ? actual.detalle_conexiones : 'SIN_CONEXIONES';\nconst nueva = actual.alerta_h4 && firma !== memoria.ultimoH4;\nmemoria.ultimoH4 = firma;\nreturn [{ json: { ...actual, alerta_h4: nueva } }];"

    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH externas AS (\n    SELECT usename, client_addr, pid\n    FROM pg_stat_activity\n    WHERE backend_type = 'client backend'\n      AND client_addr IS NOT NULL\n      AND NOT (client_addr <<= '172.19.0.0/16'::inet)\n)\nSELECT COUNT(*)::int AS total_conexiones,\n       COALESCE(STRING_AGG(usename || '@' || client_addr::text || ' (pid ' || pid || ')', ' | '), 'Ninguna') AS detalle_conexiones,\n       COUNT(*) > 0 AS alerta_h4\nFROM externas;",
        "options": {}
      },
